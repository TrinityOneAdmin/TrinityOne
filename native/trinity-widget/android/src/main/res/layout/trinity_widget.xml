<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trinity_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/trinity_widget_bg"
    android:padding="6dp">
    <StackView
        android:id="@+id/trinity_widget_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />
    <TextView
        android:id="@+id/trinity_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/trinity_widget_empty"
        android:textColor="@color/trinity_widget_ink2"
        android:textSize="14sp" />
</FrameLayout>
