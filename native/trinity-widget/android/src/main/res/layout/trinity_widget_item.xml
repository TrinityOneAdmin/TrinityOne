<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trinity_widget_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/trinity_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/trinity_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/trinity_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/trinity_widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:textColor="@color/trinity_widget_ink"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/trinity_widget_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/trinity_widget_ink2"
        android:textSize="12sp" />
</LinearLayout>
