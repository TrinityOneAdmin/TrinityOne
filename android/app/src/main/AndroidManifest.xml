<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App links for church invites. Without this the app had only a LAUNCHER filter, so a member who
              followed an invite, installed the APK and opened it arrived at a blank first-run with the invite
              context (?follow=&relay=&name=) thrown away — they then had to type the church name by hand.

              autoVerify makes Android fetch https://<host>/.well-known/assetlinks.json and check our signing
              cert; both hosts serve it (gateway.mjs route + the tracked .well-known/ copy in the Pages deploy —
              scripts/assetlinks-on-every-surface.test.mjs). If verification fails — self-hosted church on a
              domain we don't serve, no network at install time — the link simply opens in the browser exactly
              as it does today. Nothing regresses; the app path is a bonus when it verifies.

              WHAT THE QRs ACTUALLY ENCODE (2026-11-24 round; proven by scripts/qr-links-open-the-app.test.mjs,
              which RUNS the URL builders against these filters):
                /join?follow=…        console JoinCard QR + join slips (Steward.joinUrl via the /join rewrite)
                /?follow=…            member "invite a friend" QR (joinLinkFor, app/identity-extras.jsx)
                /?follow=…#invite=…   guardian→child handoff (inviteUrlFor) + Set up accounts member slips
                                      (Steward.memberInviteUrl) — the seed rides in the FRAGMENT, never the query
                https://app.trinityone.church   the console's plain "get the app" QR (path "/" once normalised)
              So the app host claims /join* AND the bare root path. The ROOT path stays a SEPARATE filter from
              the marketing apex below: Android unions hosts × paths WITHIN one filter, and trinityone.church/
              is the marketing site — claiming it would swallow every link to the sales page.

              trinityone.church: the web console runs there too (steward.html on the Pages deploy), and
              joinUrl() builds from location.origin whenever it is public — so printed QRs with
              https://trinityone.church/join?follow=… exist (see join.js). Claim /join on the apex, root NOT.
              Self-hosted church domains cannot be claimed: the manifest is fixed at build time (and the
              gateway's assetlinks note says the same) — those QRs keep opening the browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.trinityone.church" android:pathPrefix="/join" />
                <data android:scheme="https" android:host="app.trinityone.church" android:path="/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="trinityone.church" android:pathPrefix="/join" />
            </intent-filter>

            <!-- BEGIN install-from-file (member only) -->
            <!--
              "Open with TrinityOne" for a Bible someone sent: tap the file in Signal / Files / Quick Share and
              choose TrinityOne. content: only (that is all Android hands another app's file as), and only the
              types a Bible or a MySword module travels as.

              application/octet-stream IS ACCEPTED ON PURPOSE, and it is the broad one: Signal and Quick Share
              often send a .mybible (a type Android has no name for) as octet-stream, so without it the commonest
              Bible file would never offer TrinityOne. The price is that TrinityOne is also offered for other
              unnamed files. That is safe: nothing is read until the member taps Install
              (app/install-bible.jsx), and an unusable file just says so. At the device check, record the MIME
              type each sender really uses (Signal, Quick Share, Bluetooth, Files) and narrow this if one of
              them proves unnecessary.

              THIS BLOCK IS MEMBER-ONLY. The Console APK builds from this same manifest and has no Library and
              no listener, so scripts/build-steward-apk.sh strips it (scripts/manifest-member-only.sh) and puts it
              back on exit. Keep the markers on their own lines.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/vnd.sqlite3" />
            </intent-filter>
            <!-- END install-from-file -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- in-app QR scanning to join a church (getUserMedia + BarcodeDetector); camera is optional -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
