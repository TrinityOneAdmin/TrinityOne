[Unit]
Description=TrinityOne public tunnel (Cloudflare named tunnel if configured, else quick tunnel) to the gateway
After=network.target trinity-gateway.service
[Service]
WorkingDirectory=/mnt/storage/projects/TrinityOne
ExecStart=/bin/bash scripts/tunnel.sh
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
